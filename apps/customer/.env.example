# TrustLink Customer app — environment variables
# Copy to .env and adjust. Expo exposes only EXPO_PUBLIC_* to the app.
#
# Data source: "mock" runs the in-memory demo layer; "api" calls the backend.
# Development defaults to "mock"; non-development builds must set this explicitly.
EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_API_URL=http://localhost:3000/api
