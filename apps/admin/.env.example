# TrustLink Admin dashboard — environment variables
# Copy to .env and adjust. Vite exposes only VITE_* to the app.
#
# Data source: "mock" runs the in-memory demo console; "api" calls the backend.
# Development defaults to "mock"; non-development builds must set this explicitly.
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:3000/api
