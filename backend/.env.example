# TrustLink Logistics - Environment Variables
# Copy this file to .env and fill in your values

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=trustlink-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=trustlink

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Payments (Paystack / Flutterwave)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Maps
GOOGLE_MAPS_API_KEY=

# SMS/OTP (Termii or Africa's Talking)
SMS_PROVIDER=termii
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=TrustLink

# KYC Verification (VerifyMe or Seamfix)
KYC_PROVIDER=verifyme
KYC_PROVIDER_API_KEY=

# Admin bootstrap (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@trustlink.ng
ADMIN_PASSWORD=

# Payment callbacks (confirm against the provider dashboards)
PAYSTACK_CALLBACK_URL=
FLUTTERWAVE_REDIRECT_URL=
APP_LOGO_URL=

# CORS allowlist — comma-separated origins, never "*" outside local development
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:5173

# Uploads (KYC documents, proof of delivery)
# local = ./uploads (development only); s3 = any S3-compatible bucket
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=