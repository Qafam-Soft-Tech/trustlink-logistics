# TrustLink Logistics - Environment Variables
# Copy this file to .env and fill in your values

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=trustlink-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=trustlink

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Payments (Paystack / Flutterwave)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Maps
GOOGLE_MAPS_API_KEY=

# SMS/OTP (Termii or Africa's Talking)
SMS_PROVIDER=termii
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=TrustLink

# KYC Verification (VerifyMe or Seamfix)
KYC_PROVIDER=verifyme
KYC_PROVIDER_API_KEY=